---
<section class="titulo flex flex-col p-4">
    <!-- Productos (Zona izquierda) -->
    <div class="productos w-full">
        <!-- Aquí van los productos, tal como en tu código original -->
        <!-- Producto 1, Producto 2, ... -->
    </div>

    <!-- Carrito (Zona derecha) -->
    <div class="carrito w-full mt-8 p-6 bg-white rounded-lg shadow-lg">
        <h2 class="carrito-titulo font-light mb-4">Mi Carrito</h2>
        <ul id="carrito-lista" class="carrito-lista list-none p-0">
            <!-- Los productos se agregarán aquí -->
        </ul>
        <div class="carrito-total mt-4 flex justify-between items-center">
            <strong class="text-xl">Total: $<span id="total">0.00</span></strong>
            <div>
                <button id="btn-limpiar" class="btn-comprar bg-pink-500 text-white px-4 py-2 rounded hover:bg-pink-800 transition-colors duration-300">
                    Limpiar carrito
                </button>
                <button id="btn-finalizar" class="btn-comprar bg-pink-500 text-white px-4 py-2 rounded hover:bg-pink-800 transition-colors duration-300">
                    Finalizar compra
                </button>
            </div>
        </div>
    </div>
</section>




